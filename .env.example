# Replace with a unique secret generated for this deployment (at least 32 bytes).
AUTH_SECRET=
# Supabase PostgreSQL transaction-pooler connection string (required for local and hosted use).
DATABASE_URL=
# Optional Supabase direct/session-pooler URL for pg_dump backups.
DATABASE_URL_DIRECT=
# Optional Supabase root CA PEM, required only if Node.js reports a certificate-chain error.
DATABASE_SSL_CA=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_RESOURCE_NAME=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# New registrations require approval; mail configuration is required before registration.
# Resend API key (server only). Use a verified sender domain.
RESEND_API_KEY=
APPROVAL_EMAIL_FROM=
SUPPORT_EMAIL=rithbtccambodia@gmail.com
APPROVAL_ADMIN_EMAIL=
# Public HTTPS origin for review links; localhost HTTP is supported in development only.
APP_BASE_URL=http://localhost:3000

# Gmail alternative: choose gmail instead of resend. Never use your normal Gmail password.
APPROVAL_MAIL_PROVIDER=resend
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional server-side X API token with recent-search access. Never use NEXT_PUBLIC_.
# Without this token, the Source check supports locally pasted posts.
X_BEARER_TOKEN=

# Optional CoinGecko Demo API key for market and chart data. Server-side only.
COINGECKO_API_KEY=

# Private account vault: generate 32 random bytes as 64 hex characters.
# Keep this stable and back it up separately from the database. Never NEXT_PUBLIC_.
EXCHANGE_ENCRYPTION_KEY=
# Exness MT5 bridge. Loopback by default; remote bridge must use HTTPS.
MT5_BRIDGE_URL=http://127.0.0.1:8787
MT5_BRIDGE_TOKEN=
# Optional dedicated Windows MT5 terminal executable for the bridge.
MT5_TERMINAL_PATH=

# ABA merchant payments: sandbox is the default. Configure production only after bank approval and testing.
ABA_PAYWAY_MODE=sandbox
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=

# Candle analysis: crypto uses public Binance OHLC with no private account key.
# Forex/metals/oil use Twelve Data; your plan must authorize the requested symbols.
TWELVEDATA_API_KEY=
# Optional Gemini review, server-only. Create an API key in Google AI Studio and
# choose a model available to your API project with structured-output support.
# Never use NEXT_PUBLIC_ for keys.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=
# Optional screenshot model override; must support image input and structured output.
# Falls back to GEMINI_ANALYSIS_MODEL when empty.
GEMINI_VISION_MODEL=

# Optional automatic closed-candle signal publishing to a Telegram group.
# Add the bot to the group and grant it permission to send messages.
# Long-running Node.js server required; Vercel serverless does not run this worker.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET_CHAT_ID=
# Comma-separated supported MARKET:TIMEFRAME entries, e.g. BTCUSDT:15m,ETHUSDT:15m.
# Defaults to BTCUSDT:15m. Forex/metals/oil also require a valid Twelve Data key and plan.
TELEGRAM_SIGNAL_MARKETS=BTCUSDT:15m
TELEGRAM_SIGNAL_REWARD_RATIO=2
