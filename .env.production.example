# Copy to .env.production on the server. Never commit the filled file.
APP_DOMAIN=example.com
APP_BASE_URL=https://example.com

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Supabase PostgreSQL transaction-pooler connection string; never commit its real value.
DATABASE_URL=
DATABASE_URL_DIRECT=
# Optional Supabase root CA PEM, required only if Node.js reports a certificate-chain error.
DATABASE_SSL_CA=

# Required for approval emails; configure a verified sender in Resend.
APPROVAL_MAIL_PROVIDER=resend
RESEND_API_KEY=
APPROVAL_EMAIL_FROM=RFX Team <noreply@example.com>
APPROVAL_ADMIN_EMAIL=
SUPPORT_EMAIL=

# Optional market data and AI integrations.
COINGECKO_API_KEY=
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=
GEMINI_VISION_MODEL=
TWELVEDATA_API_KEY=
X_BEARER_TOKEN=

# Required only when storing encrypted private exchange credentials.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EXCHANGE_ENCRYPTION_KEY=

# Keep payments in sandbox until the bank confirms production credentials and testing.
ABA_PAYWAY_MODE=sandbox
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=

# Optional Azure media features; leave empty if unused.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_RESOURCE_NAME=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Optional remote MT5 bridge. The default local bridge is not available in this container.
MT5_BRIDGE_URL=http://127.0.0.1:8787
MT5_BRIDGE_TOKEN=
MT5_TERMINAL_PATH=
